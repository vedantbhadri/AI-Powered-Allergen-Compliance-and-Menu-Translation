# AWS allergen system - environment variable reference.
#
# NOTE: the app does NOT load a .env file (no python-dotenv). This file is a
# human-readable reference of the variables and their expected values only.
# To actually configure the app, either:
#   * run .\setup_aws_env.ps1 (one-stop, sets everything), or
#   * export the variables manually in your shell before starting the app.
# See README.md "Configuration" section for the full table.

# ================================================
# AWS credential configuration (long-term mode)
# ================================================

# Warning: never hard-code credentials in code!
# Use one of the following instead:
# 1. Configure via `aws configure`
# 2. Set them in system environment variables
# 3. Use a .env file (development only)

# AWS credentials (if you must set them via env vars)
# AWS_ACCESS_KEY_ID=AKIA...              # Access Key ID, starts with AKIA
# AWS_SECRET_ACCESS_KEY=...              # Matching Secret Access Key
# AWS_SESSION_TOKEN=                    # Optional, only for temporary credentials

# ================================================
# AWS service configuration
# ================================================

# General default region (overridden by the per-service regions below)
AWS_REGION=ap-southeast-2

# ---- Per-service regions (important) ----
# This project's resources span two regions: Bedrock/KB in ap-southeast-2,
# DynamoDB/S3/Textract in us-east-1. Each service reads its own override
# variable and falls back to AWS_REGION when unset.
BEDROCK_REGION=ap-southeast-2      # Bedrock runtime
KB_REGION=ap-southeast-2           # Bedrock Knowledge Base
DYNAMODB_REGION=us-east-1          # DynamoDB table
S3_REGION=us-east-1                # menu uploads bucket
TEXTRACT_REGION=us-east-1          # Textract OCR

# Bedrock configuration
# Use an inference profile id (au.* / global.*) - the bare foundation-model
# id (e.g. "anthropic.claude-opus-4-6-v1") is rejected by Converse with
# ValidationException. au.* is lowest-latency from ap-southeast-2.
BEDROCK_MODEL_ID=au.anthropic.claude-opus-4-6-v1
# Bedrock Knowledge Base for the compliance RAG layer (aws engine).
# Empty/unset = RAG silently degrades to local docs/ search.
KNOWLEDGE_BASE_ID=CBFZTLLUHU
# BEDROCK_ENDPOINT_URL=            # optional custom endpoint

# S3 configuration (for uploaded menu documents)
# S3_BUCKET=allergen-demo-dev-menu-uploads-669232219904
# S3_PREFIX=uploads/

# DynamoDB configuration (for stored analysis results)
# DYNAMODB_TABLE=allergen-demo-dev-menu-items
# DYNAMODB_ENDPOINT_URL=           # local development only

# ================================================
# Application run mode
# ================================================

# Run mode: true = local simulation, false = real AWS services
LOCAL_MODE=false

# Development / debugging
DEBUG=true
LOG_LEVEL=INFO

# ================================================
# Application-specific configuration
# ================================================

# Flask application
FLASK_APP=application.py
FLASK_ENV=development
FLASK_RUN_PORT=8000

# CORS configuration
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ================================================
# Usage
# ================================================
# 1. Configure AWS credentials once: `aws configure` (writes to
#    ~/.aws/credentials), using IAM long-term keys.
# 2. Set the app's runtime variables: run .\setup_aws_env.ps1 (recommended)
#    or export the variables in this file manually in your shell.
# 3. Start the app: cd app; .\.venv\Scripts\python.exe application.py
# 4. Open http://localhost:8000 in a browser